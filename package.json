{
  "name": "@gjs27/dsh-context-compaction",
  "description": "Native context compaction engine for DeepSeek Harness: layered incremental summarization with key-information retention rules and tunable early trigger, extending the official BasicCompactionEngine via its sole summarize() hook.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "test",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context-window",
    "summarization"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
